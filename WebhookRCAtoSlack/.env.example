KOMODOR_API_KEY=replace-me
# Alternatively: KOMODOR_API_KEY_FILE=/run/secrets/komodor-api-key
# Portable/simple option. This posts one message because incoming webhooks do
# not return a message timestamp for threaded replies.
SLACK_WEBHOOK_URI=https://hooks.slack.com/services/replace-me
# Alternatively: SLACK_WEBHOOK_URI_FILE=/run/secrets/slack-webhook-uri

# Optional alternative for summary + threaded details:
# SLACK_BOT_TOKEN=xoxb-replace-me
# SLACK_CHANNEL_ID=C0123456789

# Strongly recommended. The webhook sender should send either:
# Authorization: Bearer <token>
# X-Webhook-Token: <token>
WEBHOOK_TOKEN=replace-me
# Alternatively: WEBHOOK_TOKEN_FILE=/run/secrets/webhook-token

LISTEN_ADDR=:8080
DEFAULT_WORKLOAD_KIND=Deployment
PROCESS_STATUSES=firing
PROCESS_SEVERITIES=critical
PUBLISH_CUSTOM_EVENT=true
POLL_INITIAL_INTERVAL=5s
POLL_MAX_INTERVAL=10s
INVESTIGATION_TIMEOUT=20m
LOG_LEVEL=info

# Useful for tests or proxies:
# KOMODOR_BASE_URL=https://api.komodor.com
# SLACK_BASE_URL=https://slack.com/api
